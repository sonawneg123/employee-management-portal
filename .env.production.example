# ──────────────────────────────────────────────────────────────────────────────
#  .env.production.example — Employee Management Portal
#
#  Template for the production .env file deployed on the EC2 host.
#
#  On EC2:
#    cp .env.production.example .env.production
#    # Fill in real values — never commit the filled file
#    chmod 600 .env.production
#
#  All values are loaded by docker-compose.prod.yml at runtime.
#  IMAGE_TAG and ECR_REGISTRY are injected by the GitHub Actions deploy step,
#  not stored in this file.
#
#  SECURITY:
#  - This example file is safe to commit (no real secrets).
#  - The filled .env.production must NEVER be committed to Git.
#  - .env.production is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Amazon RDS MySQL 8) ─────────────────────────────────────────────
# DB_HOST: RDS endpoint from AWS Console → RDS → Databases → your-db → Endpoint
DB_HOST=your-rds-instance.xxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=emp_portal
DB_USER=emp_user
DB_PASSWORD=REPLACE_WITH_RDS_USER_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Minimum 32 characters (256 bits) for HS256 signing.
JWT_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_RANDOM_SECRET

# ── CORS ──────────────────────────────────────────────────────────────────────
# The public URL of the application (EC2 IP, EIP, or custom domain)
CORS_ORIGINS=http://YOUR_EC2_IP_OR_DOMAIN
