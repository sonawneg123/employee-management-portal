# ──────────────────────────────────────────────────────────────────────────────
#  .env.production.example — Employee Management Portal
#
#  Template for the production .env file deployed on the EC2 host at:
#    /opt/emp-portal/.env.production
#
#  On EC2:
#    cp .env.production.example /opt/emp-portal/.env.production
#    # Fill in all REPLACE_WITH_* values
#    chmod 600 /opt/emp-portal/.env.production
#
#  WHICH VARIABLES GO HERE vs. CI:
#    This file (on EC2):
#      DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD, JWT_SECRET, CORS_ORIGINS
#    Injected by GitHub Actions deploy step (NOT in this file):
#      IMAGE_TAG      — git sha from github.sha
#      ECR_REGISTRY   — from vars.ECR_REGISTRY
#      AWS_REGION     — from vars.AWS_REGION
#
#  SECURITY:
#  - This example file is safe to commit (placeholder values only).
#  - The filled .env.production must NEVER be committed to Git.
#  - .env.production is covered by .gitignore (.env.production entry).
#  - Set permissions: chmod 600 /opt/emp-portal/.env.production
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Amazon RDS MySQL 8) ─────────────────────────────────────────────
# DB_HOST: RDS endpoint — AWS Console → RDS → Databases → your-db → Connectivity
# Example: emp-portal-db.c7abc123defg.us-east-1.rds.amazonaws.com
DB_HOST=REPLACE_WITH_RDS_ENDPOINT

DB_PORT=3306

# Database name — must match what you created during RDS setup
DB_NAME=emp_portal

# Application database user and password
# This is NOT the RDS master/root user — create a dedicated application user
DB_USER=emp_user
DB_PASSWORD=REPLACE_WITH_STRONG_APP_DB_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
# Minimum 32 characters (256 bits) for HS256 signing.
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET_openssl_rand_base64_48

# Optional overrides (defaults are set in application-prod.properties)
# JWT_EXPIRY_MS=86400000           # 24 hours
# JWT_REFRESH_EXPIRY_MS=604800000  # 7 days

# ── CORS ──────────────────────────────────────────────────────────────────────
# The public URL of the application as seen by the browser.
# Use the EC2 Elastic IP, public DNS, or your domain name.
# Format: http://YOUR_DOMAIN_OR_IP  (no trailing slash)
CORS_ORIGINS=http://REPLACE_WITH_EC2_PUBLIC_IP_OR_DOMAIN
