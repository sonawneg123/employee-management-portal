# ──────────────────────────────────────────────────────────────────────────────
#  .env.example — Employee Management Portal
#
#  Copy this file to .env and fill in real values before running Docker Compose.
#
#    cp .env.example .env
#
#  IMPORTANT:
#  - .env is listed in .gitignore and must NEVER be committed to source control.
#  - All secret values must be changed from these examples before deployment.
# ──────────────────────────────────────────────────────────────────────────────

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Root password for the MySQL container (only used during initialisation)
MYSQL_ROOT_PASSWORD=RootChangeMe123!

# Application database name, username, and password
DB_NAME=emp_portal
DB_USER=emp_user
DB_PASSWORD=AppChangeMe456!

# ── JWT ───────────────────────────────────────────────────────────────────────
# Minimum 32 characters (256 bits) for HS256 signing.
# Generate with: openssl rand -base64 48
JWT_SECRET=ReplaceWithAtLeast32CharRandomStringChangeBeforeDeploy!!

# Optional: override token expiry durations (milliseconds)
# JWT_EXPIRY_MS=86400000         # 24 hours (default)
# JWT_REFRESH_EXPIRY_MS=604800000 # 7 days (default)

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed origins for the backend (comma-separated).
# For Docker Compose local setup this should be the Nginx frontend URL.
CORS_ORIGINS=http://localhost

# ── Groq AI (chat completions) ────────────────────────────────────────────────
# Required for the AI HR Assistant chat feature (Phase 1).
# Groq is used EXCLUSIVELY for chat completions — NOT for embeddings.
# Obtain a free API key at: https://console.groq.com/keys
#
# IMPORTANT: NEVER commit a real API key to source control.
#            Keep this file out of git (it is listed in .gitignore).
#
GROQ_API_KEY=your-groq-api-key-here
# Chat model to use. See https://console.groq.com/docs/models for available options.
# llama3-8b-8192 was retired by Groq in April 2025.
# Recommended: llama-3.1-8b-instant (fast, free tier) or llama-3.3-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant

# ── Hugging Face (embeddings only — Phase 3 RAG) ──────────────────────────────
# Required for Phase 3 RAG vector search. Groq does NOT provide an embeddings API.
# Obtain a free token at: https://huggingface.co/settings/tokens
# A READ-scoped user access token is sufficient for Inference API access.
#
# IMPORTANT: NEVER commit a real token to source control.
#
HF_TOKEN=your-huggingface-token-
# Optional: override the embedding model (default: nomic-ai/nomic-embed-text-v1.5, 768-dim)
# Must be a full Hugging Face model ID that supports the feature-extraction pipeline.
# RAG_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
